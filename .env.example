# API do back (opcional; dev usa proxy Vite em /api)
VITE_API_URL=http://localhost:4000

# Stripe Payment Links (landing /landingpage)
# Dev: .env.local — lido no `npm run dev` (Vite)
# Railway/prod: mesmas variáveis no painel do serviço (runtime via docker-entrypoint)
# Também funcionam no build Docker se definidas como build args
VITE_STRIPE_CHECKOUT_STARTER=https://buy.stripe.com/test_...
VITE_STRIPE_CHECKOUT_TEAM=https://buy.stripe.com/test_...
VITE_STRIPE_CHECKOUT_SCALE=https://buy.stripe.com/test_...
VITE_STRIPE_CHECKOUT_BUSINESS=https://buy.stripe.com/test_...

# Email "Fale com vendas" (opcional)
VITE_SALES_EMAIL=vendas@empresa.com
